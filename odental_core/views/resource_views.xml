<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odental_site_list" model="ir.ui.view"><field name="name">odental.site.list</field><field name="model">odental.site</field><field name="arch" type="xml"><list><field name="name"/><field name="organization_id"/><field name="address"/></list></field></record>
    <record id="view_odental_site_form" model="ir.ui.view"><field name="name">odental.site.form</field><field name="model">odental.site</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="organization_id"/><field name="address"/><field name="active"/></group></sheet></form></field></record>
    <record id="action_odental_site" model="ir.actions.act_window"><field name="name">Sedes</field><field name="res_model">odental.site</field><field name="view_mode">list,form</field></record>
    <record id="view_odental_resource_list" model="ir.ui.view"><field name="name">odental.resource.list</field><field name="model">odental.resource</field><field name="arch" type="xml"><list><field name="name"/><field name="resource_type"/><field name="site_id"/><field name="organization_id"/><field name="user_id"/></list></field></record>
    <record id="view_odental_resource_form" model="ir.ui.view"><field name="name">odental.resource.form</field><field name="model">odental.resource</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="resource_type"/><field name="active"/></group><group><field name="organization_id"/><field name="site_id" domain="[('organization_id', '=', organization_id)]"/><field name="user_id" invisible="resource_type != 'assistant'"/></group></group><field name="notes"/></sheet></form></field></record>
    <record id="action_odental_resource" model="ir.actions.act_window"><field name="name">Recursos</field><field name="res_model">odental.resource</field><field name="view_mode">list,form</field></record>
</odoo>

