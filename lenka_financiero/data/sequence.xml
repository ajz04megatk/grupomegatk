    <record id="seq_lenka_payment" model="ir.sequence">
        <field name="name">Cobro Lenka</field>
        <field name="code">lenka.payment</field>
        <field name="prefix">LENKA-PAG-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_lenka_disbursement" model="ir.sequence">
        <field name="name">Desembolso Lenka</field>
        <field name="code">lenka.disbursement</field>
        <field name="prefix">LENKA-DES-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
