<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_lenka_financial_operation" model="ir.sequence">
        <field name="name">Operacion Financiera Lenka</field>
        <field name="code">lenka.financial.operation</field>
        <field name="prefix">LENKA-OP-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
